{
  "name": "js-nes",
  "private": true,
  "version": "0.0.0",
  "description": "JS風DSLで本物のNES ROMを生成するブラウザ完結ツール",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "npm run dev --workspace apps/web",
    "build": "npm run build --workspaces --if-present",
    "build:unoptimized": "npm run build:unoptimized --workspace apps/web",
    "test": "npm run test --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present"
  },
  "engines": {
    "node": ">=20"
  }
}
